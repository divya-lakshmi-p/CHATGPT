    cin >>k;

   int closest = arr[0]+arr[1]+arr[2];
    for(int i=0; i<n-2; i++)
    {
        int left = i+1 , right = n-1;

        while(left < right)
        {
            sum = arr[i]+arr[left]+arr[right];

            if(abs(sum -k) < abs(closest-k))
            closest=sum;

            if(sum == k)
            {
                return sum;
            }
            else if(sum < k)
            left++;
            else
            right--;
        }
    }

    return closest;
}

int main()
{
    int n;
    cin >> n;

    int arr[n];
    for(int i=0; i<n; i++)
    {
        cin >> arr[i];
    }

    sort(arr, arr+n);

    cout << separateevenodd(arr , n);

   
}
 

