6. Merge Two Sorted Arrays ⭐⭐
Example:
A = [1,3,5]
B = [2,4,6]
Output:
[1,2,3,4,5,6]
Pattern:
i →
j →
This is important because it introduces two pointers moving in the same direction.

C++
#include<bits/stdc++.h>
using namespace std;

void mergearray(int arr[],int brr[] , int n, int m)
{
    int k = m+n-1;
    int left = n-1 , right = m-1;

    while(left >=0  && right>=0)
    {
        if(arr[left] > brr[right])
        {
            arr[k] = arr[left];
            left--;
        }
        else{
            arr[k] = brr[right];
            right--;
        }
        k--;

    }
    while(right >=0)
    {
        arr[k]= brr[right];
        right--;
        k--;
    }



    for(int i=0; i<m+n; i++)
    {
        cout<< arr[i]<<" ";
    }
    cout<<endl;
}
int main()
{
    int n ,m;
    cin >> n >>m;

    int arr[n+m] ,brr[m];

    for(int i=0; i<n; i++)
    {
        cin >> arr[i];
    }
    for(int j=0;j<m; j++)
    {
        cin >> brr[j];
    }

    mergearray( arr , brr, n, m);
}





