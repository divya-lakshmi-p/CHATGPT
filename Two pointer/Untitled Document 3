1. Reverse an Array ⭐
Given:
[1, 2, 3, 4, 5]
Output:
[5, 4, 3, 2, 1]
Pattern: Left + Right


C++

#include<bits/stdc++.h>
using namespace std;

void reversearray(int arr[] , int n)
{
    int left =0, right = n-1;
    while(left <right)
    {
        swap(arr[left] , arr[right]);
        left++;
        right--;
    }

    for(int i=0; i<n; i++)
    {
        cout<< arr[i] <<" ";
    }
}

int main()
{
    int n;
    cin >> n;

    int arr[n];
    for(int i=0; i<n; i++)
    {
        cin >> arr[i];
    }

    reversearray(arr, n);
}


