7. Two Sum in Sorted Array ⭐⭐⭐
arr = [2,7,11,15]
target = 9
Output:
2 + 7 = 9
Pattern: Left + Right
This is the fundamental Two Pointer problem.


C++
#include<bits/stdc++.h>
using namespace std;

pair<int,  int> twosum(int arr[] ,int n)
{
    int left =0 , right = n-1, k;
    cin >>k;

    while(left <= right)
    {
        int sum = arr[left]+arr[right];
        if(sum == k)
            return {arr[left] , arr[right]};
        else if(sum <k)
            left++;
        else
            right--;
    }

    return {-1, -1};
}

int main()
{
    int n;
    cin >> n;

    int arr[n];
    for(int i=0; i<n; i++)
    {
        cin >> arr[i];
    }

   pair<int , int> sum = twosum(arr, n);

   cout<<sum.first <<" "<< sum.second<<endl;
}










