12. Separate Even and Odd Numbers ⭐⭐
Example:
[1,2,3,4,5,6]
Partition into:
[2,4,6,1,3,5]
Exact order may or may not matter depending on the problem.
Pattern: Left + Right partition

#include<bits/stdc++.h>
using namespace std;

void separateevenodd(int arr[] , int n)
{
    int left =0, right =n-1;
    while(left < right )
    {
        while(left < right && arr[left] %2 ==0)
        left++;
        while(left < right && arr[right] %2 !=0)
        right --;

        if(left < right)
        {
            swap(arr[left] , arr[right]);
            left++;
            right--;
        }
    }
    for(int i=0; i<n;  i++)
    {
        cout<<arr[i]<<"  ";
    }
    cout<<endl;
}

int main()
{
    int n;
    cin >> n;

    int arr[n];
    for(int i=0; i<n; i++)
    {
        cin >> arr[i];
    }

    separateevenodd(arr , n);
}





