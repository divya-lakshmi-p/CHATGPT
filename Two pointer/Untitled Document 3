15. 3Sum ⭐⭐⭐⭐
Example:
[-1,0,1,2,-1,-4]
Output:
[-1,-1,2]
[-1,0,1]
Pattern:
Fix one element
        +
Two Pointers
This is a major interview problem.


#include<bits/stdc++.h>
using namespace std;

vector<vector<int>>separateevenodd(int arr[] , int n)
{
    int k ;
    cin >>k;

    vector<vector<int>>ans;

    for(int i=0; i<n-2; i++)
    {
        if(i>0 && arr[i] == arr[i-1])   this is used to skip the previous value if it is same , why means it will going to create the same pair anyway in future
        continue;

        int left = i+1 , right = n-1;

        while(left < right)
        {

            int add = arr[i] + arr[left] + arr[right];

            if(add > k)
            right--;
            else if(add < k)
            left++;
            else{
                ans.push_back({arr[i] , arr[left] , arr[right]});
                left++;
                right--;

                while(left < right && arr[left] == arr[left-1])   //same here also  
                left++;
                while(left < right && arr[right] == arr[right+1])
                right--;
            }
        }
    }

    return ans;
}

int main()
{
    int n;
    cin >> n;

    int arr[n];
    for(int i=0; i<n; i++)
    {
        cin >> arr[i];
    }

    sort(arr, arr+n);

    vector<vector<int>> sum = separateevenodd(arr , n);

    for(auto v : sum )
    {
        cout<<"[";

        for(auto x:v)
        {
            cout << x<<", ";
        }

        cout<<"]";
    }
    cout<<endl;
}

