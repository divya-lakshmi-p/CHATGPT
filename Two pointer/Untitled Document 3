9. Remove Duplicates from Sorted Array ⭐⭐⭐
Input:
[1,1,2,2,3,3]
Output:
[1,2,3]
Pattern:
slow →
fast →
Very important for in-place modification.

#include<bits/stdc++.h>
using namespace std;

int removeduplicate(int arr[] , int n)
{
    int left =0;

    for(int i=i; i<n; i++)
    {
        if(arr[i]!= arr[left])
        {   left++;
            arr[left] = arr[i];
        }
    }

    return left+1;
    
}

int main()
{
    int n;
    cin >> n;

    int arr[n];
    for(int i=0; i<n; i++)
    {
        cin >> arr[i];
    }

    int sum = removeduplicate(arr , n);

    for(int i=0; i<sum ; i++)
    {
        cout<<arr[i]<<" ";
    }
    cout<<endl;
}



Java 

import java.util.Scanner;

class Main
{   
    static int removeduplicate(int [] arr ,  int n )
    {
        int left =0;

        for(int i=1; i<n; i++)
        {
            if(arr[i] != arr[left])
            { left++;
                arr[left] = arr[i];

            }
        }

        return left+1;
    }
    public static void main(String [] args)
    {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

